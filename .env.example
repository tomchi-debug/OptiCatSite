# Stripe Configuration
# Hämta dessa från ditt Stripe Dashboard (https://dashboard.stripe.com/apikeys)

# Publik nyckel som används på frontend
STRIPE_PUBLIC_KEY=pk_test_...

# Hemlig nyckel som används på backend (håll denna hemlig!)
STRIPE_SECRET_KEY=sk_test_...

# Valfritt: URL för framgångsrik betalning och avbruten betalning
STRIPE_SUCCESS_URL=https://din-doman.se/tack
STRIPE_CANCEL_URL=https://din-doman.se/butik