---
import Layout from '../layouts/Layout.astro';

const products = [
	{
		id: 'opticat-starter',
		name: 'OptiCat Starter',
		price: '990 kr/mån',
		description: 'För mindre grossister med upp till 5 000 artiklar.',
		features: ['Obegränsade sökningar', 'Standard-mall', 'RSK-koppling']
	},
	{
		id: 'opticat-pro',
		name: 'OptiCat Pro',
		price: '2 490 kr/mån',
		description: 'För växande grossister med upp till 50 000 artiklar.',
		features: ['Kundspecifika prislistor', 'Eget varumärke', 'Prioriterad support']
	},
	{
		id: 'opticat-enterprise',
		name: 'OptiCat Enterprise',
		price: 'Offert',
		description: 'För stora aktörer med behov av ERP-integration och tunga datamängder.',
		features: ['Full API-åtkomst', 'Anpassade integrationer', 'Dedicated success manager']
	}
];
---

<Layout title="Butik | OptiCat">
	<main>
		<section class="shop-hero">
			<div class="wrap">
				<span class="eyebrow">Prissättning</span>
				<h1>Hitta rätt nivå för <br><span class="grad">er verksamhet.</span></h1>
				<p class="lead">Välj det paket som bäst passar ert sortiment och era kunders behov. Inga dolda startavgifter.</p>
			</div>
		</section>

		<section class="products">
			<div class="wrap product-grid">
				{products.map(product => (
					<div class="product-card">
						<div class="card-top">
							<h3>{product.name}</h3>
							<div class="price">{product.price}</div>
							<p>{product.description}</p>
						</div>
						<ul class="features">
							{product.features.map(feature => (
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
									{feature}
								</li>
							))}
						</ul>
						<button class="btn btn-primary buy-button" data-product-id={product.id}>
							Välj paket
						</button>
					</div>
				))}
			</div>
		</section>

		<section class="stripe-info">
			<div class="wrap">
				<div class="info-box">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
					<p>Säkra betalningar via <strong>Stripe</strong>. Alla priser exkl. moms.</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	// Exempel på Stripe-integration (frontend)
	const buyButtons = document.querySelectorAll('.buy-button');
	
	buyButtons.forEach(button => {
		button.addEventListener('click', () => {
			const productId = button.getAttribute('data-product-id');
			console.log(`Initierar köp för: ${productId}`);
			
			// Här skulle man anropa en API-route eller använda Stripe Checkout Redirect
			alert(`Tack för ditt intresse för ${productId}! Denna integration kräver STRIPE_PUBLIC_KEY i .env filen.`);
		});
	});
</script>

<style>
	.shop-hero {
		padding: 100px 0 60px;
		background: var(--vit);
		border-bottom: 1px solid var(--plat);
		text-align: center;
	}
	.shop-hero .wrap {
		max-width: 45rem;
	}
	.shop-hero h1 {
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		margin-bottom: 20px;
	}
	.shop-hero .grad {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.shop-hero .lead {
		font-size: 1.15rem;
		color: #3e4c59;
	}

	.products {
		padding: 80px 0;
	}
	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 30px;
	}
	.product-card {
		background: var(--vit);
		border: 1px solid var(--plat);
		border-radius: 16px;
		padding: 40px 32px;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.product-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 30px rgba(31, 41, 51, 0.08);
	}
	.card-top h3 {
		font-size: 1.5rem;
		margin-bottom: 12px;
	}
	.price {
		font-size: 2rem;
		font-weight: 800;
		color: var(--stal);
		margin-bottom: 20px;
		font-family: 'Archivo', sans-serif;
	}
	.card-top p {
		color: #7b8794;
		font-size: 0.95rem;
		margin-bottom: 30px;
		min-height: 3em;
	}
	.features {
		list-style: none;
		margin-bottom: 40px;
		flex-grow: 1;
	}
	.features li {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 14px;
		font-size: 0.95rem;
		color: #3e4c59;
	}
	.features svg {
		color: var(--kyla);
		flex-shrink: 0;
	}
	.product-card .btn {
		width: 100%;
		text-align: center;
	}

	.stripe-info {
		padding-bottom: 80px;
	}
	.info-box {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 20px;
		background: rgba(27, 108, 168, 0.05);
		border-radius: var(--radius);
		color: #3e4c59;
		font-size: 0.9rem;
	}
	.info-box svg {
		color: var(--kyla);
	}

	@media (max-width: 1000px) {
		.product-grid {
			grid-template-columns: 1fr;
			max-width: 400px;
			margin: 0 auto;
		}
	}
</style>
